\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Hard B의 제외 영역. 원본, L2, Block형, HuGS형, 최종 Robust형, Geometry/UV fusion, UV+shadow guard 순서다. 원본 UV 마스크를 투영한 선택과 사선 영상별 독립 검출의 차이를 같은 사진에서 비교한다.\relax }}{18}{figure.caption.24}\protected@file@percent }
\newlabel{fig:b-masks}{{10}{18}{Hard B의 제외 영역. 원본, L2, Block형, HuGS형, 최종 Robust형, Geometry/UV fusion, UV+shadow guard 순서다. 원본 UV 마스크를 투영한 선택과 사선 영상별 독립 검출의 차이를 같은 사진에서 비교한다.\relax }{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Hard C의 제외 영역. B와 같은 순서와 표시 규칙이다. Shadow guard는 차체 마스크 밖의 어두운 이웃까지 제외할 수 있다. 빨간 영역은 차량ㆍ그림자의 정답 분할이 아니라 각 방법이 실제 사용하지 않는 관측이다.\relax }}{19}{figure.caption.25}\protected@file@percent }
