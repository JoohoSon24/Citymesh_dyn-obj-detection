\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces 동일 Hard 평가에서의 개선안. 학습형 PSNR은3seed 평균$\pm $표본표준편차, 다른 열은 평균. UV 직접 합성 두 방법은 결정적 계산1회로 표준편차가 없다.\relax }}{12}{table.caption.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 동일4개 고정 차량 위치의 개선안 비교. 주황선은 평가 OBB로 시각화에만 표시했다. 모든 결과는seed42, 동일 cropㆍ동일 색 범위다. UV 합성에서 차체와 중첩 흔적은 줄지만 일부 어두운 흔적과 주변 차량은 남는다. 폴리곤 밖 인접 차량은 해당 표본 점수에 포함되지 않는다.\relax }}{12}{figure.caption.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 전체 장면 비교. 윗줄B, 아랫줄C. 미적용 L2, Block형, HuGS형, Robust형, UV fusion, UV+shadow guard, Geometry+prior 순서다. 미관측 영역의 보간ㆍ그림자ㆍ주변 잔류 차량까지 포함해 보아야 한다.\relax }}{13}{figure.caption.16}\protected@file@percent }
