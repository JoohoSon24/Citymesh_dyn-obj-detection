\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces 추가 채움 방법의 동일 평가 비교. 기존 학습형은3seed 평균$\pm $표본표준편차, 직접 재구성은 결정적1회다. PSNR은dB, LPIPS는전체 채택OBB의 객체 평균이다.\relax }}{14}{table.caption.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 새 두 방법을 같은4개 고정 차량 위치에 추가한 비교. 원본 차량 관측,2026 배경, L2, Block형, UV+shadow guard, Gradient harmonization, Patch transfer 순서다. 주황선은 평가 OBB이며 모든 방법에 동일한 crop과 색 범위를 사용했다.\relax }}{14}{figure.caption.18}\protected@file@percent }
\newlabel{fig:natural-crops}{{5}{14}{새 두 방법을 같은4개 고정 차량 위치에 추가한 비교. 원본 차량 관측,2026 배경, L2, Block형, UV+shadow guard, Gradient harmonization, Patch transfer 순서다. 주황선은 평가 OBB이며 모든 방법에 동일한 crop과 색 범위를 사용했다.\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 채움 자체를 보기 위한 추가 확대. 고정 채택 OBB와 겹치는 완전 미관측 연결성분 중 장면별 최대 영역을 원본 마스크만으로 선택했다. 좌표 선정에는 방법별 출력이나 평가 오차를 사용하지 않았다. 차체 모양의 어두운 흔적과 흐림은 여전히 남아 완전 해결을 뜻하지 않는다.\relax }}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:natural-holes}{{6}{15}{채움 자체를 보기 위한 추가 확대. 고정 채택 OBB와 겹치는 완전 미관측 연결성분 중 장면별 최대 영역을 원본 마스크만으로 선택했다. 좌표 선정에는 방법별 출력이나 평가 오차를 사용하지 않았다. 차체 모양의 어두운 흔적과 흐림은 여전히 남아 완전 해결을 뜻하지 않는다.\relax }{figure.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces 추가 진단(seed42). Gradient L1은2026 기준과의 인접 RGB 차분 오차(낮을수록 좋음), hole은모든 학습 관측이 제외된 픽셀, 경계는hole의3픽셀 이웃이다. 작은 부분집합이며 자연스러움의 사람 평가가 아니다.\relax }}{15}{table.caption.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 추가 두 방법의 빨간 제외 마스크. 장면별2025년ㆍ20도 입력이며 위B, 아래C다. 두 방법 모두 같은 shadow-guard S를 사용해 빨간 영역이 동일하다. 차이는 마스크가 아니라 선택된 관측으로 배경을 채우는 방식이다. 회색은 valid 밖이다.\relax }}{16}{figure.caption.21}\protected@file@percent }
\newlabel{fig:natural-masks}{{7}{16}{추가 두 방법의 빨간 제외 마스크. 장면별2025년ㆍ20도 입력이며 위B, 아래C다. 두 방법 모두 같은 shadow-guard S를 사용해 빨간 영역이 동일하다. 차이는 마스크가 아니라 선택된 관측으로 배경을 채우는 방식이다. 회색은 valid 밖이다.\relax }{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 추가 방법을 포함한 전체 장면. L2, Block형, UV fusion, UV+shadow guard, Gradient harmonization, Patch transfer 순서이며 위Bㆍ아래C다. 국소 개선뿐 아니라 남은 어두운 흔적ㆍ평활화ㆍ잘못 복사된 질감도 함께 평가한다.\relax }}{16}{figure.caption.22}\protected@file@percent }
\newlabel{fig:natural-full}{{8}{16}{추가 방법을 포함한 전체 장면. L2, Block형, UV fusion, UV+shadow guard, Gradient harmonization, Patch transfer 순서이며 위Bㆍ아래C다. 국소 개선뿐 아니라 남은 어두운 흔적ㆍ평활화ㆍ잘못 복사된 질감도 함께 평가한다.\relax }{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}관측 선택의 시각화: 빨간색은 제외한 관측 S=0}{18}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Easy 입력의 제외 영역. 윗줄은 원본, L2, Block형, HuGS형이며 아랫줄은 Robust 기본ㆍORㆍ차량 크기ㆍ깊이 적응이다. 빨간색이 많다고 제거 품질이 높다는 의미는 아니며 주차선과 지면의 잘못된 제외도 함께 살핀다.\relax }}{18}{figure.caption.23}\protected@file@percent }
